# Text files are stored with LF and checked out with LF, on every platform.
#
# This is not a style preference. The repository holds conformance vectors
# and fuzz corpus files whose SHA-256 is quoted in reference.json and in CI.
# If a contributor on Windows checks them out with CRLF, those checksums
# stop matching and a vector file silently becomes a different file.
* text=auto eol=lf

# Conformance vectors, corpus and any other file whose bytes are a contract.
fuzz/** binary
tests/fixtures/** binary
*.bin binary
*.mp1 binary
*.mp2 binary
*.mp3 binary
*.pcm binary
*.wav binary

# The lockfile is generated by cargo and is LF by construction.
Cargo.lock text eol=lf
